{
  "name": "cosma-android",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "android:sync": "npm run build && cap sync android && node scripts/verify-android.mjs",
    "android:add": "npm run build && cap add android",
    "test:android": "node scripts/verify-android.mjs",
    "test:ui": "node tests/browser.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
